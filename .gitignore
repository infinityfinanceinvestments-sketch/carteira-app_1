# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# banco de dados local — tem dados reais de clientes (posições, valores),
# nunca deve ir pro controle de versão nem ser compartilhado
data.db
data.db-journal
data.db-wal
data.db-shm
*.db
*.db-journal
*.db-wal
*.db-shm

# backups do banco (gerados por backup-data.ps1) — mesma razão: dados reais
backups/
