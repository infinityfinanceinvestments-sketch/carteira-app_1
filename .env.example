# Copie este arquivo pra ".env.local" (que já é ignorado pelo Git) e
# preencha os valores reais antes de rodar em produção. Em desenvolvimento
# local (npm run dev) nenhuma dessas variáveis é obrigatória.

# Obrigatória em produção. Chave usada pra assinar a sessão de login (JWT).
# Gere uma bem forte e aleatória, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Se não for definida, o app RECUSA iniciar em modo produção (next start) —
# isso é de propósito, pra nunca ir ao ar com uma chave fraca/padrão.
AUTH_SECRET=

# Opcional. Só é necessária quando o envio automático de e-mail (redefinição
# de senha / verificação em dois fatores) estiver ativado. Sem ela, o app
# continua funcionando do jeito atual: o consultor gera um link manualmente
# e manda pro cliente por fora do app.
# Crie uma conta grátis em https://resend.com pra gerar essa chave.
RESEND_API_KEY=

# Opcional. Só é necessária se/quando o banco for migrado de SQLite (arquivo
# local data.db) pra um Postgres hospedado (Neon, Railway, Supabase etc.).
# Formato: postgres://usuario:senha@host:porta/banco
DATABASE_URL=

# Opcional. Caminho do arquivo do banco SQLite. Em desenvolvimento local não
# precisa definir (usa "data.db" na raiz do projeto). Em produção, aponte
# pra dentro de um disco persistente (ex: um volume do Railway montado em
# /data) — senão o banco é apagado a cada novo deploy.
DB_PATH=

# Opcionais, só usadas em produção. Se definidas E o banco ainda não tiver
# nenhum consultor cadastrado, o app cria essa conta automaticamente na
# primeira vez que sobe — assim dá pra fazer o primeiro login sem precisar
# rodar nenhum comando manual no servidor. Depois que a conta existir, essas
# variáveis não fazem mais nada (podem ficar ou ser removidas).
CONSULTOR_EMAIL=
CONSULTOR_SENHA=
CONSULTOR_NOME=

# Opcional. Liga a trava de "muitas tentativas de login" (bloqueia por um
# tempo depois de várias senhas erradas seguidas do mesmo IP). Desligada
# por padrão — defina como "true" pra ativar quando o app estiver estável
# em produção. Sem isso, não tem limite de tentativas de login/2FA.
LOGIN_RATE_LIMIT_ATIVO=
